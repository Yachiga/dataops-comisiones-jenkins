{
  "name": "ls_blob_raw",
  "properties": {
    "type": "AzureBlobStorage",
    "description": "Blob Storage donde se deposita el CSV de comisiones (contenedor raw). Cadena de conexión guardada en Key Vault.",
    "annotations": [
      "dataops-comisiones"
    ],
    "typeProperties": {
      "connectionString": {
        "type": "AzureKeyVaultSecret",
        "store": {
          "referenceName": "ls_keyvault",
          "type": "LinkedServiceReference"
        },
        "secretName": "storage-connection-string"
      }
    }
  }
}