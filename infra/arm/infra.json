{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Infraestructura DataOps comisiones: ADLS Gen2 (raw/staging/curated), Key Vault y Azure Data Factory con Managed Identity."
  },
  "parameters": {
    "entorno": {
      "type": "string",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ]
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "prefijo": {
      "type": "string",
      "defaultValue": "dataops",
      "maxLength": 10
    },
    "sufijoUnico": {
      "type": "string",
      "defaultValue": "[substring(uniqueString(resourceGroup().id), 0, 5)]"
    },
    "pgPassword": {
      "type": "secureString",
      "metadata": {
        "description": "Contraseña del usuario PostgreSQL de solo lectura (desde variable secreta de Azure DevOps)."
      }
    },
    "storageSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS"
      ]
    },
    "deployerObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "ObjectId del Service Principal de la service connection (para subir el CSV y leer el Parquet en las pruebas)."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "proyecto": "dataops-comisiones",
        "curso": "DMC-DataOps"
      }
    }
  },
  "variables": {
    "storageName": "[toLower(concat('st', parameters('prefijo'), parameters('entorno'), parameters('sufijoUnico')))]",
    "keyVaultName": "[toLower(concat('kv-', parameters('prefijo'), '-', parameters('entorno'), '-', parameters('sufijoUnico')))]",
    "factoryName": "[toLower(concat('adf-', parameters('prefijo'), '-', parameters('entorno'), '-', parameters('sufijoUnico')))]",
    "containers": [
      "raw",
      "staging",
      "curated"
    ],
    "roleBlobDataContributor": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "roleKvSecretsUser": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "tagsEntorno": "[union(parameters('tags'), createObject('entorno', parameters('entorno')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tagsEntorno')]",
      "sku": {
        "name": "[parameters('storageSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "isHnsEnabled": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true,
        "accessTier": "Hot"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('storageName'), '/default/', variables('containers')[copyIndex()])]",
      "copy": {
        "name": "contenedores",
        "count": "[length(variables('containers'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tagsEntorno')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(variables('keyVaultName'), '/pg-dmc-password')]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ],
      "properties": {
        "value": "[parameters('pgPassword')]"
      }
    },
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[variables('factoryName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tagsEntorno')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "globalParameters": {
          "entorno": {
            "type": "String",
            "value": "[parameters('entorno')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), variables('factoryName'), 'blob-contrib')]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', variables('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
        "[resourceId('Microsoft.DataFactory/factories', variables('factoryName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('roleBlobDataContributor')]",
        "principalId": "[reference(resourceId('Microsoft.DataFactory/factories', variables('factoryName')), '2018-06-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), variables('factoryName'), 'kv-secrets-user')]",
      "scope": "[concat('Microsoft.KeyVault/vaults/', variables('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.DataFactory/factories', variables('factoryName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('roleKvSecretsUser')]",
        "principalId": "[reference(resourceId('Microsoft.DataFactory/factories', variables('factoryName')), '2018-06-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[not(empty(parameters('deployerObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), parameters('deployerObjectId'), 'deployer-blob')]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', variables('storageName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('roleBlobDataContributor')]",
        "principalId": "[parameters('deployerObjectId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "blobEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))).primaryEndpoints.blob]"
    },
    "dfsEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))).primaryEndpoints.dfs]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))).vaultUri]"
    },
    "factoryName": {
      "type": "string",
      "value": "[variables('factoryName')]"
    }
  }
}